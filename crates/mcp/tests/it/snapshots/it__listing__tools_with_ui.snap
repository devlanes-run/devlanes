---
[
  {
    "name": "status",
    "description": "Show lanes and units with state, ports, URLs, CPU and memory.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "lane": {
          "type": "string",
          "description": "Lane to show ([project@]lane) [default: every lane of the current project]"
        },
        "mine": {
          "type": "boolean",
          "description": "Only show units this agent session started"
        },
        "cwd": {
          "type": "string",
          "description": "Worktree directory to run in, which picks its lane; relative to the server's directory."
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "title": "devlanes status",
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "_meta": {
      "ui": {
        "resourceUri": "ui://devlanes/lane.html"
      }
    }
  },
  {
    "name": "start",
    "description": "Bring up a lane: infra, setup, tasks and services, then wait until ready. Starts the lane of the current worktree, or only the named units. Units that already run are left alone, so starting twice is safe. Waits until every started unit is ready or one fails; Ctrl-C detaches and leaves everything running. Without units or --profile it brings back the services the lane ran before, such as after a reboot or daemon crash. A lane stopped with devlanes stop has nothing to bring back and starts its default profile; start.restore: false in ~/.devlanes/config.yaml always does that. Returns once the units are ready or one failed, or at the timeout the server adds with what is ready so far; then call wait. No sleep or curl polling.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "units": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Units to start ([lane:]unit, globs, +tag) [default: what the lane ran before, else its default profile]"
        },
        "profile": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Start the units of this profile from devlanes.yaml; repeat to combine profiles (later ones win on env)"
        },
        "all_at_once": {
          "type": "boolean",
          "description": "Start every selected service immediately, bypassing the machine-wide start gate for this run"
        },
        "lane": {
          "type": "string",
          "description": "Use this lane ([project@]lane) instead of the current worktree's"
        },
        "timeout": {
          "type": "string",
          "description": "How long to wait, such as 30s or 5m [default for commands that wait: a little under the host's tool call limit]"
        },
        "env": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Variables for the processes the command starts, as KEY=VALUE"
        },
        "cwd": {
          "type": "string",
          "description": "Worktree directory to run in, which picks its lane; relative to the server's directory."
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "title": "devlanes start",
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "_meta": {
      "ui": {
        "resourceUri": "ui://devlanes/lane.html"
      }
    }
  },
  {
    "name": "exec",
    "description": "Run an ad-hoc command as a unit of the lane instead of backgrounding it with &. The daemon owns the process: logs, stop, attach and status work on it by its --name, and it gets the lane's environment. Use it for dev servers, watchers, workers, tunnels and anything else that keeps running, never nohup or a background shell. command is the program and its arguments. The result says how to read and stop the unit.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Unit name for the command, used by logs, stop and attach"
        },
        "no_pty": {
          "type": "boolean",
          "description": "Use pipes instead of a pseudoterminal"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Command and arguments to run"
        },
        "lane": {
          "type": "string",
          "description": "Use this lane ([project@]lane) instead of the current worktree's"
        },
        "env": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Variables for the processes the command starts, as KEY=VALUE"
        },
        "cwd": {
          "type": "string",
          "description": "Worktree directory to run in, which picks its lane; relative to the server's directory."
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "command"
      ]
    },
    "annotations": {
      "title": "devlanes exec",
      "readOnlyHint": false,
      "destructiveHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "logs",
    "description": "Read unit logs; each line carries a cursor to continue from. Lines of several units are merged by time. Each line starts with a cursor such as api#120 that --cursor and --around accept. In agent mode and without a terminal the output defaults to the last 100 lines within the output budget. follow needs timeout.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "units": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Units to read ([lane:]unit, globs, +tag) [default: pick from a list]"
        },
        "all": {
          "type": "boolean",
          "description": "Read every unit of the lane, grouped by unit"
        },
        "tail": {
          "type": "integer",
          "description": "Show the last N lines [default: 100 in agent mode or without a terminal]"
        },
        "head": {
          "type": "integer",
          "description": "Show the first N lines of the selected range"
        },
        "follow": {
          "type": "boolean",
          "description": "Keep streaming new lines; agent mode requires --timeout"
        },
        "since": {
          "type": "string",
          "description": "Only lines newer than a duration (5m), a time in milliseconds, or start (the lane's last start)"
        },
        "grep": {
          "type": "string",
          "description": "Only lines matching this regular expression"
        },
        "level": {
          "type": "string",
          "description": "Only lines at this level or above: debug, info, warn or error"
        },
        "around": {
          "type": "string",
          "description": "Show the lines around this cursor, such as api#120"
        },
        "context": {
          "type": "integer",
          "default": 3,
          "description": "Lines before and after --around"
        },
        "cursor": {
          "type": "string",
          "description": "Continue after this cursor, as printed by an earlier logs call"
        },
        "mine": {
          "type": "boolean",
          "description": "Only units this agent session started"
        },
        "lane": {
          "type": "string",
          "description": "Use this lane ([project@]lane) instead of the current worktree's"
        },
        "timeout": {
          "type": "string",
          "description": "How long to wait, such as 30s or 5m [default for commands that wait: a little under the host's tool call limit]"
        },
        "cwd": {
          "type": "string",
          "description": "Worktree directory to run in, which picks its lane; relative to the server's directory."
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "title": "devlanes logs",
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "_meta": {
      "ui": {
        "resourceUri": "ui://devlanes/lane.html"
      }
    }
  },
  {
    "name": "stop",
    "description": "Stop units, or the whole lane when none are named. Stopped services are left out of what a plain devlanes start brings back. A whole-lane stop also forgets the lane's profiles, so its next plain start uses the default profile. Stop your own units with mine when they are done, and leave the lane running when you hand work to the user for review.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "units": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Units to stop ([lane:]unit, globs, +tag) [default: the whole lane]"
        },
        "mine": {
          "type": "boolean",
          "description": "Only stop units this agent session started; with no units, across every lane"
        },
        "logs_dir": {
          "type": "string",
          "description": "Write each unit's log of this run to DIR as text files, for CI artifacts"
        },
        "lane": {
          "type": "string",
          "description": "Use this lane ([project@]lane) instead of the current worktree's"
        },
        "cwd": {
          "type": "string",
          "description": "Worktree directory to run in, which picks its lane; relative to the server's directory."
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "title": "devlanes stop",
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "restart",
    "description": "Stop and start units again with a fresh environment, or the whole lane when none are named. A whole-lane restart stops everything, keeps the lane's saved profiles and services, and starts it again as a plain devlanes start does: infra, setup, tasks, services and any port change in the project file. Returns once the units are ready or one failed, or at the timeout the server adds with what is ready so far; then call wait. No sleep or curl polling.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "units": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Units to restart ([lane:]unit, globs, +tag) [default: the whole lane]"
        },
        "all_at_once": {
          "type": "boolean",
          "description": "Start every selected service immediately, bypassing the machine-wide start gate for this run"
        },
        "lane": {
          "type": "string",
          "description": "Use this lane ([project@]lane) instead of the current worktree's"
        },
        "timeout": {
          "type": "string",
          "description": "How long to wait, such as 30s or 5m [default for commands that wait: a little under the host's tool call limit]"
        },
        "env": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Variables for the processes the command starts, as KEY=VALUE"
        },
        "cwd": {
          "type": "string",
          "description": "Worktree directory to run in, which picks its lane; relative to the server's directory."
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "title": "devlanes restart",
      "readOnlyHint": false,
      "destructiveHint": true,
      "openWorldHint": false
    },
    "_meta": {
      "ui": {
        "resourceUri": "ui://devlanes/lane.html"
      }
    }
  },
  {
    "name": "reload",
    "description": "Apply project file and .env changes to the running lane. Stops the units the file removed, restarts the ones it changed and starts the ones it added. Without units, a change to infra or ports restarts the whole lane instead. With units, it applies only their changes. devlanes status shows what changed. Returns once the units are ready or one failed, or at the timeout the server adds with what is ready so far; then call wait. No sleep or curl polling.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "units": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Apply only these units' changes ([lane:]unit) [default: every change in the lane]"
        },
        "all_at_once": {
          "type": "boolean",
          "description": "Start every selected service immediately, bypassing the machine-wide start gate for this run"
        },
        "lane": {
          "type": "string",
          "description": "Use this lane ([project@]lane) instead of the current worktree's"
        },
        "timeout": {
          "type": "string",
          "description": "How long to wait, such as 30s or 5m [default for commands that wait: a little under the host's tool call limit]"
        },
        "cwd": {
          "type": "string",
          "description": "Worktree directory to run in, which picks its lane; relative to the server's directory."
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "title": "devlanes reload",
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "_meta": {
