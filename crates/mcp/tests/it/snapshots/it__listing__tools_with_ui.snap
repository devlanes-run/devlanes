  },
  {
    "name": "wait",
    "description": "Wait until a unit or lane is ready or failed. Returns the reason and log tail of a failure, or what is ready at the timeout. Call it when start, restart or reload returned at their timeout.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
