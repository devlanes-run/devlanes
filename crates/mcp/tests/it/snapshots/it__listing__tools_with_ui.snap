  {
    "name": "doctor",
    "description": "Check the daemon, Docker, proxy, CA, hosts file and output mode, each with a fix; never starts the daemon.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "lane": {
          "type": "string",
          "description": "Use this lane ([project@]lane) instead of the current worktree's"
        },
        "cwd": {
          "type": "string",
          "description": "Worktree directory to run in, which picks its lane; relative to the server's directory."
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "title": "devlanes doctor",
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "devlanes",
    "description": "Run a devlanes command that has no tool of its own, such as debug config, infra status, remote ls, config get or lane new, or any command with --help. args is the command line after \"devlanes\", such as [\"infra\", \"status\"] or [\"debug\", \"config\"]. Use the other tools first: start, exec, logs, stop and the rest take typed arguments. Returns the command's agent output, with its JSON in structuredContent.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The devlanes command line without \"devlanes\", one element per argument."
        },
        "cwd": {
          "type": "string",
          "description": "Worktree directory to run in, which picks its lane; relative to the server's directory."
        }
      },
      "required": [
        "args"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "title": "devlanes",
      "readOnlyHint": false,
      "destructiveHint": true,
      "openWorldHint": false
    },
    "_meta": {
      "ui": {
        "resourceUri": "ui://devlanes/lane.html"
      }
    }
  },
  {
    "name": "app_snapshot",
    "description": "Lanes and units for the lane card, with metrics when asked, the lanes of linked boxes when no lane is asked for, and the number of each lane's newest card.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "cwd": {
          "type": "string",
          "description": "Worktree directory to run in, which picks its lane; relative to the server's directory."
        },
        "lane": {
          "type": "string"
        },
        "metrics": {
          "type": "boolean"
        }
      }
    },
    "_meta": {
      "ui": {
        "visibility": [
          "app"
        ]
      }
    }
  },
  {
    "name": "app_logs",
    "description": "Log lines of units for the card's log viewer.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "cwd": {
          "type": "string",
          "description": "Worktree directory to run in, which picks its lane; relative to the server's directory."
        },
        "units": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tail": {
          "type": "integer",
          "minimum": 1
        },
        "cursor": {
          "type": "string"
        },
        "grep": {
          "type": "string"
        },
        "since": {
          "type": "string"
        }
      },
      "required": [
        "units"
      ]
    },
    "_meta": {
      "ui": {
        "visibility": [
          "app"
        ]
      }
    }
  },
  {
    "name": "app_action",
    "description": "A button of the card: start, stop, restart, reload, clean, clean_plan or pair, on a lane or unit. Only the user's click calls it, and the click is the consent: clean and pair run without asking again.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "cwd": {
          "type": "string",
          "description": "Worktree directory to run in, which picks its lane; relative to the server's directory."
        },
        "action": {
          "type": "string",
          "enum": [
            "start",
            "stop",
            "restart",
            "reload",
            "clean",
            "clean_plan",
            "pair"
          ]
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "action"
      ]
    },
    "_meta": {
      "ui": {
        "visibility": [
          "app"
        ]
      }
    }
  }
]
