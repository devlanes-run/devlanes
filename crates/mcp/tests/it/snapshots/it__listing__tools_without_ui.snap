        "list": {
          "type": "boolean",
          "description": "List the tasks and the script sources they use"
        },
        "detach": {
          "type": "boolean",
          "description": "Start the task in the background and return"
        },
        "lane": {
          "type": "string",
          "description": "Use this lane ([project@]lane, such as 2, feat/checkout or acme@2) instead of the current worktree's"
        },
        "env": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Variables for the processes the command starts, as KEY=VALUE such as DEBUG=1"
        },
        "yes": {
          "type": "boolean",
          "description": "Skip the server's question to the user; set it only when the user already agreed in the chat"
        },
        "cwd": {
          "type": "string",
          "description": "Worktree directory to run in, which picks the project and lane [default: the agent's project]"
        }
      },
      "additionalProperties": false
