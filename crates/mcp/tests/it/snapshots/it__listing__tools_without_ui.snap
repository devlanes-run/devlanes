---
source: crates/mcp/tests/it/listing.rs
expression: tools(&harness).await
---
[
  {
    "name": "status",
    "description": "Show lanes and units with state, ports, URLs, CPU and memory. Call it first to see what runs and whether it is ready, and to find the URL that opens a service.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "lane": {
          "type": "string",
          "description": "Lane to show ([project@]lane, such as 2, feat/checkout or acme@2) [default: every lane of the current project]"
        },
        "mine": {
          "type": "boolean",
          "description": "Only show units this agent session started"
        },
        "cwd": {
          "type": "string",
          "description": "Worktree directory to run in, which picks the project and lane [default: the agent's project]"
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "title": "devlanes status",
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "start",
    "description": "Bring up a lane: infra, setup, tasks and services, then wait until ready. To run a command devlanes.yaml does not define, use exec. It returns once every unit is ready or one failed, or at the timeout with what is ready so far; then call wait instead of sleeping or polling.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "units": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Units to start ([lane:]unit, a glob or +tag, such as api, 2:web, api-* or +backend) [default: what the lane ran before, else its default profile]"
        },
        "profile": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Start the units of this profile from devlanes.yaml; repeat to combine profiles (later ones win on env)"
        },
        "all_at_once": {
          "type": "boolean",
          "description": "Start every selected service immediately, bypassing the machine-wide start gate for this run"
        },
        "lane": {
          "type": "string",
          "description": "Use this lane ([project@]lane, such as 2, feat/checkout or acme@2) instead of the current worktree's"
        },
        "timeout": {
          "type": "string",
          "description": "How long to wait or stream, such as 30s or 5m [default for commands that wait: a little under the host's tool call limit]"
        },
        "env": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Variables for the processes the command starts, as KEY=VALUE such as DEBUG=1"
        },
        "cwd": {
          "type": "string",
          "description": "Worktree directory to run in, which picks the project and lane [default: the agent's project]"
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "title": "devlanes start",
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "exec",
    "description": "Run an ad-hoc command as a unit of the lane instead of backgrounding it with &. Use it for dev servers, watchers, workers and tunnels, never nohup or a background shell: the process gets the lane's ports and env, and logs, status and stop find it by name.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Unit name for the command, such as web, used by logs, stop and attach"
        },
        "no_pty": {
          "type": "boolean",
          "description": "Use pipes instead of a pseudoterminal"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Command and arguments to run"
        },
        "lane": {
          "type": "string",
          "description": "Use this lane ([project@]lane, such as 2, feat/checkout or acme@2) instead of the current worktree's"
        },
        "env": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Variables for the processes the command starts, as KEY=VALUE such as DEBUG=1"
        },
        "cwd": {
          "type": "string",
          "description": "Worktree directory to run in, which picks the project and lane [default: the agent's project]"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "command"
      ]
    },
    "annotations": {
      "title": "devlanes exec",
      "readOnlyHint": false,
      "destructiveHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "logs",
    "description": "Read unit logs; each line carries a cursor to continue from. For why a unit failed or is not ready, call debug_why first; logs reads more of what a unit printed.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "units": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Units to read ([lane:]unit, a glob or +tag, such as api, 2:web, api-* or +backend) [default: pick from a list]"
        },
        "all": {
          "type": "boolean",
          "description": "Read every unit of the lane, grouped by unit"
        },
        "tail": {
          "type": "integer",
          "description": "Show the last N lines [default: 100 in agent mode or without a terminal]"
        },
        "head": {
          "type": "integer",
          "description": "Show the first N lines of the selected range"
        },
        "follow": {
          "type": "boolean",
          "description": "Keep streaming new lines; agent mode requires --timeout"
        },
        "since": {
          "type": "string",
          "description": "Only lines newer than a duration (5m), a time in milliseconds, or start (the lane's last start)"
        },
        "grep": {
          "type": "string",
          "description": "Only lines matching this regular expression, such as timeout|refused"
        },
        "level": {
          "type": "string",
          "description": "Only lines at this level or above: debug, info, warn or error"
        },
        "around": {
          "type": "string",
          "description": "Show the lines around this cursor, such as api#120"
        },
        "context": {
          "type": "integer",
          "default": 3,
          "description": "Lines before and after --around"
        },
        "cursor": {
          "type": "string",
          "description": "Continue after this cursor, as printed by an earlier logs call"
        },
        "mine": {
          "type": "boolean",
          "description": "Only units this agent session started"
        },
        "lane": {
          "type": "string",
          "description": "Use this lane ([project@]lane, such as 2, feat/checkout or acme@2) instead of the current worktree's"
        },
        "timeout": {
          "type": "string",
          "description": "How long to wait or stream, such as 30s or 5m [default for commands that wait: a little under the host's tool call limit]"
        },
        "cwd": {
          "type": "string",
          "description": "Worktree directory to run in, which picks the project and lane [default: the agent's project]"
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "title": "devlanes logs",
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "stop",
    "description": "Stop units, or the whole lane when none are named. Call it with mine to stop what you started once you are done. Leave the lane running when you hand work to the user for review.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "units": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Units to stop ([lane:]unit, a glob or +tag, such as api, 2:web, api-* or +backend) [default: the whole lane]"
        },
        "mine": {
          "type": "boolean",
          "description": "Only stop units this agent session started; with no units, across every lane"
        },
        "logs_dir": {
          "type": "string",
          "description": "Write each unit's log of this run to DIR as text files, for CI artifacts"
        },
        "lane": {
          "type": "string",
          "description": "Use this lane ([project@]lane, such as 2, feat/checkout or acme@2) instead of the current worktree's"
        },
        "cwd": {
          "type": "string",
          "description": "Worktree directory to run in, which picks the project and lane [default: the agent's project]"
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "title": "devlanes stop",
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "restart",
    "description": "Stop and start units again with a fresh environment, or the whole lane when none are named. Call it when a service has to pick up code or env it reads only at startup; after editing devlanes.yaml or .env, reload restarts only what changed. It returns once the units are ready or one failed, or at the timeout with what is ready so far; then call wait.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "units": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Units to restart ([lane:]unit, a glob or +tag, such as api, 2:web, api-* or +backend) [default: the whole lane]"
        },
        "all_at_once": {
          "type": "boolean",
          "description": "Start every selected service immediately, bypassing the machine-wide start gate for this run"
        },
        "lane": {
          "type": "string",
          "description": "Use this lane ([project@]lane, such as 2, feat/checkout or acme@2) instead of the current worktree's"
        },
        "timeout": {
          "type": "string",
          "description": "How long to wait or stream, such as 30s or 5m [default for commands that wait: a little under the host's tool call limit]"
        },
        "env": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Variables for the processes the command starts, as KEY=VALUE such as DEBUG=1"
        },
        "cwd": {
          "type": "string",
          "description": "Worktree directory to run in, which picks the project and lane [default: the agent's project]"
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "title": "devlanes restart",
      "readOnlyHint": false,
      "destructiveHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "reload",
    "description": "Apply project file and .env changes to the running lane. Call it after editing devlanes.yaml or .env instead of restarting the lane. It returns once the units are ready or one failed, or at the timeout with what is ready so far; then call wait.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "units": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Apply only these units' changes ([lane:]unit, such as api or 2:web) [default: every change in the lane]"
        },
        "all_at_once": {
          "type": "boolean",
          "description": "Start every selected service immediately, bypassing the machine-wide start gate for this run"
        },
        "lane": {
          "type": "string",
          "description": "Use this lane ([project@]lane, such as 2, feat/checkout or acme@2) instead of the current worktree's"
        },
        "timeout": {
          "type": "string",
          "description": "How long to wait or stream, such as 30s or 5m [default for commands that wait: a little under the host's tool call limit]"
        },
        "cwd": {
          "type": "string",
          "description": "Worktree directory to run in, which picks the project and lane [default: the agent's project]"
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "title": "devlanes reload",
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "wait",
    "description": "Wait until a unit or lane is ready or failed. Call it when start, restart or reload returned at their timeout, or for units another client is starting; a failure comes back with its reason and log tail.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "description": "Unit ([lane:]unit) or lane ([project@]lane) to wait for, such as api, 2:web or acme@2 [default: pick from a list]"
        },
        "lane": {
          "type": "string",
          "description": "Use this lane ([project@]lane, such as 2, feat/checkout or acme@2) instead of the current worktree's"
        },
        "timeout": {
          "type": "string",
          "description": "How long to wait or stream, such as 30s or 5m [default for commands that wait: a little under the host's tool call limit]"
        },
        "cwd": {
          "type": "string",
          "description": "Worktree directory to run in, which picks the project and lane [default: the agent's project]"
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "title": "devlanes wait",
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "with",
    "description": "Start the lane, run a command against it, then stop what was started. Use it for tests and other commands that exit and need the lane running; the command gets the lane's env and service URLs, and the result has its exit code and output. Run commands that do not need the lane in your own shell.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "units": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Units to start ([lane:]unit, a glob or +tag, such as api, 2:web, api-* or +backend) [default: what the lane ran before, else its default profile]"
        },
        "profile": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Start the units of this profile from devlanes.yaml; repeat to combine profiles (later ones win on env)"
        },
        "logs_dir": {
          "type": "string",
          "description": "Write every unit's log of the run to DIR as text files, for CI artifacts"
        },
        "keep": {
          "type": "boolean",
          "description": "Leave the lane running afterwards, for debugging"
        },
        "all_at_once": {
          "type": "boolean",
          "description": "Start every selected service immediately, bypassing the machine-wide start gate for this run"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Command and arguments to run once the lane is ready"
        },
        "lane": {
          "type": "string",
          "description": "Use this lane ([project@]lane, such as 2, feat/checkout or acme@2) instead of the current worktree's"
        },
        "timeout": {
          "type": "string",
          "description": "How long to wait or stream, such as 30s or 5m [default for commands that wait: a little under the host's tool call limit]"
        },
        "cwd": {
          "type": "string",
          "description": "Worktree directory to run in, which picks the project and lane [default: the agent's project]"
        }
      },
      "additionalProperties": false,
      "required": [
        "command"
      ]
    },
    "annotations": {
      "title": "devlanes with",
      "readOnlyHint": false,
      "destructiveHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "run",
    "description": "Run a task from devlanes.yaml and exit with its exit code. Use it for project tasks such as migrations or seeds; the server asks the user first when the task sets confirm.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "task": {
          "type": "string",
          "description": "Task to run, as named under tasks: in devlanes.yaml, or one infra entry as infra.setup.NAME or infra.teardown.NAME [default: pick from a list]"
