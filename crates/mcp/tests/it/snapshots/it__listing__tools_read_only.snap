  {
    "name": "env_show",
    "description": "Print the environment of the lane or of one unit as KEY=VALUE lines.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "unit": {
          "type": "string",
          "description": "Unit whose environment to print ([lane:]unit) [default: the lane's variables]"
        },
        "explain": {
          "type": "boolean",
          "description": "Show where each variable comes from; secret values are hidden"
        },
        "lane": {
          "type": "string",
          "description": "Use this lane ([project@]lane) instead of the current worktree's"
        },
        "cwd": {
          "type": "string",
          "description": "Worktree directory to run in, which picks its lane; relative to the server's directory."
        }
