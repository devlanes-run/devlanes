      }
    }
  },
  {
    "name": "url_print",
    "description": "Print a service's URL, for scripts.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "unit": {
          "type": "string",
          "description": "Service whose URL to print ([lane:]unit) [default: pick from a list]"
        },
        "lane": {
          "type": "string",
          "description": "Use this lane ([project@]lane) instead of the current worktree's"
        },
        "cwd": {
          "type": "string",
