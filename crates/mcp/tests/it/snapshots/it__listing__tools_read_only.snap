  },
  {
    "name": "debug_top",
    "description": "Show CPU and memory per lane and unit. The tool for any question about what uses CPU or memory: units and containers per lane, with the system's totals.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "lane": {
          "type": "string",
          "description": "Use this lane ([project@]lane) instead of the current worktree's"
        },
        "cwd": {
          "type": "string",
          "description": "Worktree directory to run in, which picks its lane; relative to the server's directory."
