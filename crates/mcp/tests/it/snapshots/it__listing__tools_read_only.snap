---
source: crates/mcp/tests/it/listing.rs
expression: tools(&harness).await
---
[
  {
    "name": "status",
    "description": "Show lanes and units with state, ports, URLs, CPU and memory.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "lane": {
          "type": "string",
          "description": "Lane to show ([project@]lane) [default: every lane of the current project]"
        },
        "mine": {
          "type": "boolean",
          "description": "Only show units this agent session started"
        },
        "cwd": {
          "type": "string",
          "description": "Worktree directory to run in, which picks its lane; relative to the server's directory."
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "title": "devlanes status",
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "_meta": {
      "ui": {
        "resourceUri": "ui://devlanes/lane.html"
      }
    }
  },
  {
    "name": "logs",
    "description": "Read unit logs; each line carries a cursor to continue from. Lines of several units are merged by time. Each line starts with a cursor such as api#120 that --cursor and --around accept. In agent mode and without a terminal the output defaults to the last 100 lines within the output budget. follow needs timeout.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "units": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Units to read ([lane:]unit, globs, +tag) [default: pick from a list]"
        },
        "all": {
          "type": "boolean",
          "description": "Read every unit of the lane, grouped by unit"
        },
        "tail": {
          "type": "integer",
          "description": "Show the last N lines [default: 100 in agent mode or without a terminal]"
        },
        "head": {
          "type": "integer",
          "description": "Show the first N lines of the selected range"
        },
        "follow": {
          "type": "boolean",
          "description": "Keep streaming new lines; agent mode requires --timeout"
        },
        "since": {
          "type": "string",
          "description": "Only lines newer than a duration (5m), a time in milliseconds, or start (the lane's last start)"
        },
        "grep": {
          "type": "string",
          "description": "Only lines matching this regular expression"
        },
        "level": {
          "type": "string",
          "description": "Only lines at this level or above: debug, info, warn or error"
        },
        "around": {
          "type": "string",
          "description": "Show the lines around this cursor, such as api#120"
        },
        "context": {
          "type": "integer",
          "default": 3,
          "description": "Lines before and after --around"
        },
        "cursor": {
          "type": "string",
          "description": "Continue after this cursor, as printed by an earlier logs call"
        },
        "mine": {
          "type": "boolean",
          "description": "Only units this agent session started"
        },
        "lane": {
          "type": "string",
          "description": "Use this lane ([project@]lane) instead of the current worktree's"
        },
        "timeout": {
          "type": "string",
          "description": "How long to wait, such as 30s or 5m [default for commands that wait: a little under the host's tool call limit]"
        },
        "cwd": {
          "type": "string",
          "description": "Worktree directory to run in, which picks its lane; relative to the server's directory."
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "title": "devlanes logs",
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "_meta": {
      "ui": {
        "resourceUri": "ui://devlanes/lane.html"
      }
    }
  },
  {
    "name": "wait",
    "description": "Wait until a unit or lane is ready or failed. Returns the reason and log tail of a failure, or what is ready at the timeout. Call it when start, restart or reload returned at their timeout.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "description": "Unit ([lane:]unit) or lane ([project@]lane) to wait for [default: pick from a list]"
        },
        "lane": {
          "type": "string",
          "description": "Use this lane ([project@]lane) instead of the current worktree's"
        },
        "timeout": {
          "type": "string",
          "description": "How long to wait, such as 30s or 5m [default for commands that wait: a little under the host's tool call limit]"
        },
        "cwd": {
          "type": "string",
          "description": "Worktree directory to run in, which picks its lane; relative to the server's directory."
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "title": "devlanes wait",
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "debug_why",
    "description": "Explain why a unit is not running or not ready, with a fix for each reason. Call it first when a unit failed or is not ready.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "unit": {
          "type": "string",
          "description": "Unit to explain ([lane:]unit) [default: pick from a list]"
        },
        "lane": {
          "type": "string",
          "description": "Use this lane ([project@]lane) instead of the current worktree's"
        },
        "cwd": {
          "type": "string",
          "description": "Worktree directory to run in, which picks its lane; relative to the server's directory."
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "title": "devlanes debug why",
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "_meta": {
      "ui": {
        "resourceUri": "ui://devlanes/lane.html"
      }
    }
  },
  {
    "name": "debug_errors",
    "description": "List failed units, crash counts, recent error lines and port conflicts.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "since": {
          "type": "string",
          "description": "Count crashes and error lines from this long ago, such as 5m or 2h [default: all recorded runs]"
