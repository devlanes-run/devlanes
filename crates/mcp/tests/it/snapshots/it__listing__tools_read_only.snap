  {
    "name": "devlanes",
    "description": "Run a devlanes command that changes nothing and has no tool of its own, such as debug config, infra status, remote ls, config get, run --list or lane clean --dry-run, or any command with --help. args is the command line after \"devlanes\", such as [\"infra\", \"status\"] or [\"lane\", \"clean\", \"2\", \"--dry-run\"]. Use the other tools first.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The devlanes command line without \"devlanes\", one element per argument."
        },
        "cwd": {
          "type": "string",
          "description": "Worktree directory to run in, which picks its lane; relative to the server's directory."
        }
      },
      "required": [
        "args"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "title": "devlanes (read only)",
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "_meta": {
      "ui": {
        "resourceUri": "ui://devlanes/lane.html"
      }
    }
  },
  {
    "name": "app_snapshot",
    "description": "Lanes and units for the lane card, with metrics when asked, the lanes of linked boxes when no lane is asked for, and the number of each lane's newest card.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "cwd": {
          "type": "string",
          "description": "Worktree directory to run in, which picks its lane; relative to the server's directory."
        },
        "lane": {
          "type": "string"
        },
        "metrics": {
          "type": "boolean"
        }
      }
    },
    "_meta": {
      "ui": {
        "visibility": [
          "app"
        ]
      }
    }
  },
  {
    "name": "app_logs",
    "description": "Log lines of units for the card's log viewer.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "cwd": {
          "type": "string",
          "description": "Worktree directory to run in, which picks its lane; relative to the server's directory."
        },
        "units": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tail": {
          "type": "integer",
          "minimum": 1
        },
        "cursor": {
          "type": "string"
        },
        "grep": {
          "type": "string"
        },
        "since": {
          "type": "string"
        }
      },
      "required": [
        "units"
      ]
    },
    "_meta": {
      "ui": {
        "visibility": [
          "app"
        ]
      }
    }
